{
    "name": "kanhaiyanigam05/seotools",
    "description": "SEO Tools for Laravel and Lumen",
    "keywords": [
        "laravel",
        "lumen",
        "seo",
        "seotools",
        "webmaster",
        "metatags",
        "opengraph",
        "json-ld"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/kanhaiyanigam05/seotools/issues",
        "source": "https://github.com/kanhaiyanigam05/seotools"
    },
    "authors": [
        {
            "name": "kanhaiya"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/config": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.4",
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Kanhaiyanigam05\\SEOTools\\": "src/SEOTools/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanhaiyanigam05\\SEOTools\\Tests\\": "tests/SEOTools"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kanhaiyanigam05\\SEOTools\\Providers\\SEOToolsServiceProvider"
            ],
            "aliases": {
                "SEOMeta": "Kanhaiyanigam05\\SEOTools\\Facades\\SEOMeta",
                "OpenGraph": "Kanhaiyanigam05\\SEOTools\\Facades\\OpenGraph",
                "Twitter": "Kanhaiyanigam05\\SEOTools\\Facades\\TwitterCard",
                "JsonLd": "Kanhaiyanigam05\\SEOTools\\Facades\\JsonLd",
                "SEO": "Kanhaiyanigam05\\SEOTools\\Facades\\SEOTools"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}